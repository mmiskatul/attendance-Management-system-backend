{
  "info": {
    "name": "University Attendance Management API",
    "_postman_id": "d43b0c6d-6aa6-4f2d-b7d3-2e8fd76f7d9f",
    "description": "Sample collection for the FastAPI attendance backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "jwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"change-me\",\n  \"tenant_id\": \"university-main\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Register Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Alice Student\",\n  \"department\": \"CSE\",\n  \"batch\": \"2024\",\n  \"semester\": \"Spring\",\n  \"email\": \"alice@example.edu\",\n  \"phone\": \"0123456789\",\n  \"barcode_value\": \"STU-2024-0001\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/students/register"
      }
    },
    {
      "name": "Get Student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/students/STU-2024-0001"
      }
    },
    {
      "name": "Enroll Faces",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": \"STU-2024-0001\",\n  \"samples\": [\n    {\"image_base64\": \"<base64-front>\", \"pose\": \"front\"},\n    {\"image_base64\": \"<base64-left>\", \"pose\": \"left\"},\n    {\"image_base64\": \"<base64-right>\", \"pose\": \"right\"}\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/faces/enroll"
      }
    },
    {
      "name": "Recognize Attendance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          },
          {
            "key": "X-Device-ID",
            "value": "terminal-1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"image_base64\": \"<base64-live-frame>\",\n  \"device_id\": \"terminal-1\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/attendance/recognize"
      }
    },
    {
      "name": "Student Attendance History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/attendance/student/STU-2024-0001"
      }
    },
    {
      "name": "Daily Attendance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/attendance/daily?attendance_date=2026-04-11"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Audit Logs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/audit-logs"
      }
    }
  ]
}

APP_NAME=University Attendance Management API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true

MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=attendance_management
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
REQUEST_ID_HEADER=X-Request-ID
TIMEZONE=Asia/Dhaka

DEFAULT_TENANT_ID=university-main
DEFAULT_CAMPUS_ID=main-campus

FACE_ENGINE_PROVIDER=insightface
FACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.78
DUPLICATE_FACE_THRESHOLD=0.88
MIN_FACE_QUALITY_SCORE=0.60
MIN_ATTENDANCE_QUALITY_SCORE=0.55
MIN_ENROLLMENT_SAMPLES=3
MAX_ENROLLMENT_SAMPLES=10
EMBEDDING_CACHE_TTL_SECONDS=300
LIVENESS_ENABLED=false

RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
ATTENDANCE_RATE_LIMIT_PER_MINUTE=60
ADMIN_RATE_LIMIT_PER_MINUTE=30

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_ROLE=admin
